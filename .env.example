# ============================================
# Personal AI Employee - Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ============================================

# Vault Configuration
VAULT_PATH=./AI_Employee_Vault
CHECK_INTERVAL=60
LOG_LEVEL=INFO
DRY_RUN=false

# Processing
PROCESSING_INTERVAL=30

# Email MCP Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_RATE_LIMIT_PER_DAY=500
EMAIL_MAX_ATTACHMENT_SIZE_MB=25

# Gmail API (if using Gmail watcher)
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# LinkedIn API
LINKEDIN_ACCESS_TOKEN=your-linkedin-token
LINKEDIN_PERSONAL_ACCOUNT_ID=your-profile-id

# Audit Logging
LOG_RETENTION_DAYS=90

# ============================================
# Gold Tier - Autonomous Processing
# ============================================
GOLD_TIER_ENABLED=true
AUTO_APPROVE_LOW_RISK=false
PROCESSING_INTERVAL=30

# Gold Tier - Scheduling
AUDIT_SCHEDULE=monday:09:00
BRIEFING_SCHEDULE=monday:10:00

# Odoo Accounting MCP
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database
ODOO_USERNAME=your_username
ODOO_API_KEY=your_api_key

# Facebook MCP
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_page_id_optional

# Twitter/X MCP
TWITTER_MODE=playwright
TWITTER_HEADLESS=false
TWITTER_SESSION_DIR=./twitter_session
TWITTER_BEARER_TOKEN=your_bearer_token
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret

# Instagram MCP (Playwright mode = free, API mode = business account needed)
INSTAGRAM_MODE=playwright
INSTAGRAM_SESSION_DIR=./twitter_session
INSTAGRAM_HEADLESS=false
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# WhatsApp MCP (extends existing)
WHATSAPP_MODE=playwright
WHATSAPP_API_TOKEN=your_token

# ============================================
# Platinum Tier - Cloud Deployment
# ============================================
DEPLOYMENT_MODE=local
# Options: 'local' (default) or 'cloud'

# GCP Secret Manager (cloud only)
GCP_PROJECT_ID=your-gcp-project-id
GCP_SECRET_NAME=ai-employee-env

# Vault Git Sync
VAULT_REPO=git@github.com:your-user/ai-employee-vault.git

# Health Check Server (cloud only)
HEALTH_PORT=8080
