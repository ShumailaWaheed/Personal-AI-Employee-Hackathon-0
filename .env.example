# ============================================
# Personal AI Employee - Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ============================================

# Vault Configuration
VAULT_PATH=./AI_Employee_Vault
CHECK_INTERVAL=60
LOG_LEVEL=INFO
DRY_RUN=false

# Processing
PROCESSING_INTERVAL=30

# Email MCP Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_RATE_LIMIT_PER_DAY=500
EMAIL_MAX_ATTACHMENT_SIZE_MB=25

# Gmail API (if using Gmail watcher)
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# LinkedIn API
LINKEDIN_ACCESS_TOKEN=your-linkedin-token
LINKEDIN_PERSONAL_ACCOUNT_ID=your-profile-id

# Audit Logging
LOG_RETENTION_DAYS=90

# ============================================
# Gold Tier - Autonomous Processing
# ============================================
GOLD_TIER_ENABLED=true
AUTO_APPROVE_LOW_RISK=false
PROCESSING_INTERVAL=30

# Gold Tier - Scheduling
AUDIT_SCHEDULE=monday:09:00
BRIEFING_SCHEDULE=monday:10:00

# Odoo Accounting MCP
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database
ODOO_USERNAME=your_username
ODOO_API_KEY=your_api_key

# Facebook MCP
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_page_id_optional

# WhatsApp MCP (extends existing)
WHATSAPP_MODE=playwright
WHATSAPP_API_TOKEN=your_token
